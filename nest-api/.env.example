# Application Port & Environment
PORT=8001
NODE_ENV=development

# Database Configuration
MASTER_DATABASE_URL=mysql://root:password@127.0.0.1:3306/saree_shop
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saree_shop
DB_USERNAME=root
DB_PASSWORD=your_database_password
DATABASE_URL=mysql://root:password@127.0.0.1:3306/saree_shop

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend URL for links in emails
FRONTEND_URL=http://localhost:3000

# Mail Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM_NAME="Saree Shop"
MAIL_FROM_ADDRESS=your_email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cashfree Payment Gateway (Sandbox / Testing Mode)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
# For Live / Production:
# CASHFREE_APP_ID=your_live_cashfree_app_id
# CASHFREE_SECRET_KEY=your_live_cashfree_secret_key
# CASHFREE_BASE_URL=https://api.cashfree.com/pg

# Delhivery Shipping
DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_BASE_URL=https://track.delhivery.com/api
DELHIVERY_CLIENT_NAME=SareeShop
DELHIVERY_PICKUP_LOCATION=Warehouse
DELHIVERY_RETURN_ADDRESS="Your Warehouse Address"
DELHIVERY_RETURN_CITY=City
DELHIVERY_RETURN_STATE=State
DELHIVERY_RETURN_PIN=000000
DELHIVERY_RETURN_PHONE=0000000000
# Set to 'true' for local testing without wallet balance / 'false' for live Delhivery API
DELHIVERY_TEST_MODE=true

# Storage
# Local development (relative path from cwd):
UPLOAD_PATH=../storage/api/public/storage
# Production / Dokploy (absolute path — matches volume mount path /app/public/storage):
# UPLOAD_PATH=/app/public/storage

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Admin User"
ADMIN_PASSWORD=admin_password
