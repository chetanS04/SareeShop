# Application Port & Environment
PORT={{ api_port }}
NODE_ENV=production

# Database Configuration
MASTER_DATABASE_URL=mysql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_DATABASE={{ db_name }}
DB_USERNAME={{ db_user }}
DB_PASSWORD={{ db_password }}
DATABASE_URL=mysql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}

# Authentication / JWT
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN={{ jwt_expires_in }}

# Frontend URL for links in emails
FRONTEND_URL={{ frontend_url }}

# Mail Configuration
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USER={{ mail_user }}
MAIL_PASS={{ mail_pass }}
MAIL_FROM_NAME="{{ mail_from_name }}"
MAIL_FROM_ADDRESS={{ mail_from_address }}

# Google OAuth
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}

# Cashfree Payment Gateway
CASHFREE_APP_ID={{ cashfree_app_id }}
CASHFREE_SECRET_KEY={{ cashfree_secret_key }}
CASHFREE_API_VERSION={{ cashfree_api_version }}
CASHFREE_BASE_URL={{ cashfree_base_url }}

# Delhivery Shipping
DELHIVERY_API_KEY={{ delhivery_api_key }}
DELHIVERY_BASE_URL={{ delhivery_base_url }}
DELHIVERY_CLIENT_NAME={{ delhivery_client_name }}
DELHIVERY_PICKUP_LOCATION={{ delhivery_pickup_location }}
DELHIVERY_RETURN_ADDRESS="{{ delhivery_return_address }}"
DELHIVERY_RETURN_CITY={{ delhivery_return_city }}
DELHIVERY_RETURN_STATE={{ delhivery_return_state }}
DELHIVERY_RETURN_PIN={{ delhivery_return_pin }}
DELHIVERY_RETURN_PHONE={{ delhivery_return_phone }}
DELHIVERY_TEST_MODE={{ delhivery_test_mode }}

# Storage (absolute path on server)
UPLOAD_PATH={{ storage_dir }}

# Admin Configuration
ADMIN_EMAIL={{ admin_email }}
ADMIN_NAME="{{ admin_name }}"
ADMIN_PASSWORD={{ admin_password }}
